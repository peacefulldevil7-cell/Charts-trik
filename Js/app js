// js/app.js
import DataLoader from '../modules/dataLoader.js';
import ChartView from '../modules/chartView.js';
import RuleEngine from '../modules/ruleEngine.js';
import Storage from '../modules/storage.js';
import UI from '../modules/ui.js';
import Report from '../modules/report.js';
import rulesRegistry from '../rules/registry.js';

const state = {
  data: null,          // loaded table: { columns:[], rows: [{date, values:[]}] }
  chart: null,
  rules: [],
  analysisResults: null
};

async function init(){
  // Initialize UI and storage
  await Storage.init();
  UI.bindUI({
    onUpload: openFilePicker,
    onPasteOpen: () => UI.showPasteModal(),
    onPasteImport: handlePaste,
    onUploadRule: handleUploadRuleFile,
    onRunAnalysis: runAnalysis,
    onSaveAnalysis: saveAnalysis,
    onExportExcel: exportExcelReport,
    onPrintReport: () => window.print(),
    onSearchNumber: searchNumber,
    onToggleTheme: UI.toggleTheme
  });

  // Load built-in rules from registry
  state.rules = await rulesRegistry.getAllRules();
  // also load uploaded rules saved in IndexedDB
  const userRules = await Storage.getUserRules();
  state.rules.push(...userRules);

  UI.renderRulesList(state.rules, toggleRuleEnabled);

  // init Chart (empty)
  state.chart = new ChartView(document.getElementById('chartCanvas'));
  UI.showMessage('Ready. Upload or paste historical data to start.', 'info');
}

async function openFilePicker(){
  const input = document.getElementById('fileInput');
  input.value = '';
  input.onchange = async (e) => {
    const f = e.target.files[0];
    if(!f) return;
    try{
      const table = await DataLoader.loadFile(f);
      state.data = table;
      UI.renderTable(table, onTableCellClick);
      state.chart.loadData(table);
      UI.showMessage('Data loaded: ' + (table.rows.length || 0) + ' rows', 'success');
    }catch(err){
      console.error(err);
      UI.showMessage('Error loading file: ' + err.message, 'error');
    }
  };
  input.click();
}

async function handlePaste(text){
  try{
    const table = DataLoader.parseClipboard(text);
    state.data = table;
    UI.renderTable(table, onTableCellClick);
    state.chart.loadData(table);
    UI.hidePasteModal();
    UI.showMessage('Data imported from paste', 'success');
  }catch(err){
    UI.showMessage('Paste import failed: ' + err.message, 'error');
  }
}

function onTableCellClick({rowIndex, colIndex, value}){
  // simple action: highlight on chart (if a series)
  UI.showMessage(`Cell [${rowIndex},${colIndex}] = ${value}`, 'info');
  state.chart.highlightCell(rowIndex, colIndex);
}

async function handleUploadRuleFile(){
  const input = document.getElementById('ruleFileInput');
  input.value = '';
  input.onchange = async (e) => {
    const f = e.target.files[0];
    if(!f) return;
    try{
      const text = await f.text();
      // Validate: module must export default rule object
      const blob = new Blob([text], { type: 'text/javascript' });
      const url = URL.createObjectURL(blob);
      const module = await import(url);
      URL.revokeObjectURL(url);
      const rule = module.default;
      if(!rule || !rule.id) throw new Error('Uploaded module must export default rule object with id.');
      // Save to IndexedDB
      await Storage.saveUserRule(rule.id, text);
      state.rules.push(rule);
      UI.renderRulesList(state.rules, toggleRuleEnabled);
      UI.showMessage('Rule uploaded and saved: ' + rule.name, 'success');
    }catch(err){
      console.error(err);
      UI.showMessage('Rule upload failed: ' + err.message, 'error');
    }
  };
  input.click();
}

function toggleRuleEnabled(ruleId, enabled){
  const r = state.rules.find(x=>x.id===ruleId);
  if(r) r.enabled = enabled;
}

async function runAnalysis(){
  if(!state.data){ UI.showMessage('No data loaded', 'error'); return; }
  UI.showMessage('Running analysis...', 'info');
  const engine = new RuleEngine(state.rules);
  const context = { ui: UI, chart: state.chart, storage: Storage };
  const results = await engine.runAll(state.data, context);
  state.analysisResults = results;
  UI.renderReport(results, state.rules);
  // apply highlights to table and chart from results
  UI.applyHighlights(results);
  state.chart.applyHighlights(results);
  UI.showMessage('Analysis complete', 'success');
}

async function saveAnalysis(){
  if(!state.analysisResults) { UI.showMessage('No analysis to save', 'error'); return; }
  const name = prompt('Save analysis name', 'Analysis ' + new Date().toLocaleString());
  if(!name) return;
  const record = {
    id: 'analysis-' + Date.now(),
    name,
    timestamp: new Date().toISOString(),
    data: state.data,
    rules: state.rules.map(r=>({id:r.id,name:r.name,enabled:!!r.enabled})),
    results: state.analysisResults
  };
  await Storage.saveAnalysis(record.id, record);
  UI.showMessage('Analysis saved', 'success');
}

async function exportExcelReport(){
  if(!state.analysisResults) { UI.showMessage('No analysis to export', 'error'); return; }
  Report.exportExcel(state.analysisResults);
}

async function searchNumber(){
  const n = document.getElementById('searchNumber').value.trim();
  if(!n){ UI.showMessage('Enter number to search', 'error'); return; }
  const results = [];
  const table = state.data;
  if(!table){ UI.showMessage('No data loaded', 'error'); return; }
  table.rows.forEach((r,ri)=>{
    r.values.forEach((v,ci)=>{
      if(String(v) === n){
        const date = r.date || null;
        results.push({row:ri,col:ci,value:v,date});
      }
    });
  });
  UI.renderSearchResults(results);
}

window.addEventListener('load', init);
